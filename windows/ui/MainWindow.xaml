<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Audio Extractor"
        Width="1120" Height="720" MinWidth="900" MinHeight="610"
        WindowStartupLocation="CenterScreen"
        Background="#0C1117" Foreground="#F0F4F8"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#151B23"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#1B222D"/>
    <SolidColorBrush x:Key="Panel3Brush" Color="#202936"/>
    <SolidColorBrush x:Key="LineBrush" Color="#293341"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#354253"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#94A0B1"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#68D8B8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#091511"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF8F8F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F4C86B"/>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F0F4F8"/>
      <Setter Property="Background" Value="#202936"/>
      <Setter Property="BorderBrush" Value="#354253"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#27313E"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="#1B222D"/>
      <Setter Property="BorderBrush" Value="#293341"/>
      <Setter Property="Padding" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Foreground" Value="#091511"/>
      <Setter Property="Background" Value="#68D8B8"/>
      <Setter Property="BorderBrush" Value="#68D8B8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>
  </Window.Resources>

  <Grid Margin="28,24,28,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="20"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
          <TextBlock Text="LA" Foreground="{StaticResource AccentTextBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Local Audio Extractor" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="Desktop utility · Local only" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border x:Name="RuntimePill" Grid.Column="1" CornerRadius="999" BorderThickness="1" BorderBrush="#295044" Background="#11241E" Padding="12,7" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="RuntimeDot" Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="RuntimeText" Text="Checking FFmpeg" Foreground="#91E5CC" FontSize="11"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.55*" MinWidth="500"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="0.72*" MinWidth="315"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="21">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="13"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="影片來源" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="檔案不會上傳到網路" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
          </Grid>

          <Border x:Name="DropZone" Grid.Row="2" Background="#10161D" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="15" AllowDrop="True" Cursor="Hand">
            <Grid Margin="24">
              <StackPanel x:Name="EmptyState" Width="390" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="17" Background="#162923" HorizontalAlignment="Center" Margin="0,0,0,17">
                  <TextBlock Text="＋" Foreground="{StaticResource AccentBrush}" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="把影片拖進視窗" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="或選擇一個本機檔案&#x0a;MP4 / MKV / MOV / WebM / AVI / M4V" Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Center" LineHeight="20" Margin="0,8,0,0"/>
                <Button x:Name="BrowseButton" Content="Browse video" Style="{StaticResource FlatButton}" Width="132" HorizontalAlignment="Center" Margin="0,18,0,0"/>
              </StackPanel>

              <StackPanel x:Name="FileState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                <Border Width="66" Height="66" CornerRadius="18" Background="#162923" HorizontalAlignment="Center" Margin="0,0,0,16">
                  <TextBlock Text="▶" Foreground="{StaticResource AccentBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </Border>
                <TextBlock x:Name="FileNameText" Text="video.mp4" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="510"/>
                <TextBlock x:Name="FileMetaText" Text="MP4 · 0 MB" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,0">
                  <Button x:Name="ReplaceButton" Content="更換影片" Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                  <Button x:Name="ClearButton" Content="移除" Style="{StaticResource FlatButton}"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SourceFooter" Text="等待影片 · 輸出會存回影片所在資料夾" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="17">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="處理方式" FontWeight="SemiBold"/>

          <StackPanel Grid.Row="2">
            <Button x:Name="ModeFast" Tag="fast" Style="{StaticResource ModeButton}">
              <StackPanel>
                <TextBlock Text="⚡  Fast Copy" FontWeight="SemiBold"/>
                <TextBlock Text="直接複製第一音軌，不重新編碼。最快、無音質損失。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Button>

            <Button x:Name="ModeSubtitles" Tag="subtitles" Style="{StaticResource ModeButton}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="◉  Subtitle Ready" FontWeight="SemiBold"/>
                  <Border Grid.Column="1" Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="6,3">
                    <TextBlock Text="推薦" Foreground="{StaticResource AccentTextBrush}" FontSize="9" FontWeight="Bold"/>
                  </Border>
                </Grid>
                <TextBlock Text="Mono · 16 kHz · 64 kbps MP3，適合 Gemini / Whisper / 字幕工具。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Button>

            <Button x:Name="ModeSplit" Tag="split" Style="{StaticResource ModeButton}">
              <StackPanel>
                <TextBlock Text="✂  Split" FontWeight="SemiBold"/>
                <TextBlock Text="字幕格式 + 自動切成多個 MP3，適合超長影片。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <Border x:Name="SplitSettings" Grid.Row="3" Visibility="Collapsed" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#121820" CornerRadius="10" Padding="11" Margin="0,0,0,9">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="每段長度" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                <TextBlock Grid.Column="1" Text="預設 30 分鐘" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="SegmentMinutes" Text="30" Width="78" Foreground="#F0F4F8" Background="#0F151C" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Padding="8,6"/>
                <TextBlock Text="分鐘 / 段" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="5">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,13"/>
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="輸出" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="SummaryOutput" Grid.Column="1" Text="MP3 · Mono" FontSize="11" FontWeight="SemiBold"/></Grid>
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="取樣率" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="SummaryRate" Grid.Column="1" Text="16 kHz · 64 kbps" FontSize="11" FontWeight="SemiBold"/></Grid>
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="預計檔名" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="SummaryFilename" Grid.Column="1" Text="等待影片" FontSize="11" FontWeight="SemiBold" MaxWidth="190" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="隱私" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Grid.Column="1" Text="100% Local" FontSize="11" FontWeight="SemiBold"/></Grid>

            <Button x:Name="StartButton" Content="開始處理  →" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
            <TextBlock x:Name="HintText" Text="選好影片後即可開始" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" Margin="0,8,0,0"/>

            <Border x:Name="StatusBox" Visibility="Collapsed" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="#11171E" CornerRadius="9" Padding="11" Margin="0,10,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="StatusTitle" Text="處理中" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock x:Name="StatusValue" Grid.Column="1" Text="" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </Grid>
                <ProgressBar x:Name="ProgressBar" Height="5" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#27313D" BorderThickness="0" Margin="0,9,0,0"/>
                <TextBlock x:Name="StatusMessage" Text="" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="44"/>
              </StackPanel>
            </Border>

            <Button x:Name="OpenFolderButton" Content="開啟輸出資料夾" Style="{StaticResource FlatButton}" Visibility="Collapsed" Margin="0,9,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>